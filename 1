# Используем официальный образ docker, в котором уже установлена сама утилита Docker
FROM docker:latest

# Устанавливаем bash и git (они нужны для работы нашего скрипта)
RUN apk add --no-cache bash git

# Копируем наш скрипт внутрь контейнера
COPY builder.sh /builder.sh

# Делаем скрипт исполняемым
RUN chmod +x /builder.sh

# Назначаем скрипт точкой входа (он будет запускаться при старте контейнера)
ENTRYPOINT ["/builder.sh"]
