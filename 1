#!/bin/bash

GITHUB_REPO=$1
DOCKER_REPO=$2

echo "Клонируем репозиторий $GITHUB_REPO..."
git clone https://github.com/$GITHUB_REPO.git temp_repo
cd temp_repo

echo "Собираем Docker-образ..."
docker build -t $DOCKER_REPO .

echo "Авторизуемся в Docker Hub..."
# Скрипт использует переменные окружения для входа
docker login -u "$DOCKER_USER" -p "$DOCKER_PWD"

echo "Отправляем образ..."
docker push $DOCKER_REPO

cd ..
rm -rf temp_repo
echo "Готово!"
